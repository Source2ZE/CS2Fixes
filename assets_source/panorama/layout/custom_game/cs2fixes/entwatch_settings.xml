<root>
    <styles>
		<include src="file://{resources}/styles/custom_game/cs2fixes/entwatch_settings.css" />
	</styles>
    <Panel class="Root" hittest="false">
        <Panel id="SettingsPanel" class="SettingsPanel Hidden" hittest="false">
            <Panel class="SettingsColumn" hittest="false">
                <Panel class="TogglePanel" hittest="false">
                    <Panel class="SettingRow ToggleRow" hittest="false">
                        <Label class="SettingName" text="EntWatch HUD" hittest="false" />
                        <Button id="ToggleEntWatchHud" class="ToggleButton">
                            <Panel hittest="false" class="ToggleKnob" />
                        </Button>
                    </Panel>

                    <Panel class="SettingRow ToggleRow" hittest="false">
                        <Label hittest="false" class="SettingName" text="Player Names" />
                        <Button id="TogglePlayerNames" class="ToggleButton Selected">
                            <Panel hittest="false" class="ToggleKnob" />
                        </Button>
                    </Panel>
                </Panel>
                <Panel class="PositionControls" hittest="false">
                    <Label hittest="false" class="SectionTitle" text="Position" />

                    <Panel class="AdjustmentRow" hittest="false">
                        <Button id="PositionXMinus10" class="AdjustmentButton">
                            <Label hittest="false" text="-10" />
                        </Button>
                        <Button id="PositionXMinus1" class="AdjustmentButton">
                            <Label hittest="false" text="-1" />
                        </Button>
                        <Panel hittest="false" class="HudPosLabel">
                            <Label hittest="false" class="AxisLabelText" id="HudPosXValue" text="{s:HudPosX}" />
                            <Label hittest="false" class="AxisLabel" text="&#x2194;" />
                        </Panel>
                        <Button id="PositionXPlus1" class="AdjustmentButton">
                            <Label hittest="false" text="+1" />
                        </Button>
                        <Button id="PositionXPlus10" class="AdjustmentButton">
                            <Label hittest="false" text="+10" />
                        </Button>
                    </Panel>

                    <Panel class="AdjustmentRow" hittest="false">
                        <Button id="PositionYMinus10" class="AdjustmentButton">
                            <Label hittest="false" text="-10" />
                        </Button>
                        <Button id="PositionYMinus1" class="AdjustmentButton">
                            <Label hittest="false" text="-1" />
                        </Button>
                        <Panel hittest="false" class="HudPosLabel">
                            <Label hittest="false" class="AxisLabelText" id="HudPosYValue" text="{s:HudPosY}" />
                            <Label hittest="false" class="AxisLabel" text="&#x2195;" />
                        </Panel>
                        <Button id="PositionYPlus1" class="AdjustmentButton">
                            <Label hittest="false" text="+1" />
                        </Button>
                        <Button id="PositionYPlus10" class="AdjustmentButton">
                            <Label hittest="false" text="+10" />
                        </Button>
                    </Panel>
                </Panel>

                <Panel class="HudSizeControls" hittest="false">
                    <Label hittest="false" class="SectionTitle" text="Hud Size" />
                    <Panel class="SizeRow">
                        <Button id="HudSizeMinus" class="AdjustmentButton SizeButton">
                            <Label hittest="false" text="-" />
                        </Button>
                        <Label hittest="false" id="HudSizeValue" class="SizeValue" text="{s:Scale}%" />
                        <Button id="HudSizePlus" class="AdjustmentButton SizeButton">
                            <Label hittest="false" text="+" />
                        </Button>
                    </Panel>
                </Panel>
            </Panel>

            <Panel class="ColorColumn" hittest="false">
                <Panel class="ColorHeader" hittest="false">
                    <Label hittest="false" class="SectionTitle ColorTitle" text="Color" />
                </Panel>
                <Panel class="ColorList" >
                    <Button id="ColorPanel-0" class="ColorPanel">
                        <Panel hittest="false" class="ColorSquare HudColour-0" />
                        <Label hittest="false" id="ColorLabel-0" class="ColorLabel HudColour-0" text="{s:ColorName}" />
                        <Panel hittest="false" class="ColorSquareEnd HudColour-0" />
                    </Button>
                    <Button id="ColorPanel-1" class="ColorPanel">
